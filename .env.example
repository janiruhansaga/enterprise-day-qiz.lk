# =========================================================================
# MINDPULSE ARENA - ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================

# Server Port & Mode
PORT=4000
NODE_ENV=production

# Datastore Selection: 'sqlite' (default for local dev) or 'firestore' (production)
DATASTORE_TYPE=sqlite

# SQLite Authoritative Database File (Used when DATASTORE_TYPE=sqlite)
DB_PATH=./data/enterprise_quiz.sqlite

# =========================================================================
# FIREBASE ADMIN SDK CONFIGURATION (Used when DATASTORE_TYPE=firestore)
# CRITICAL: Never commit real private keys or service account credentials!
# =========================================================================

# Option A: Direct Environment Injection (Recommended for Cloud Run / Container deployments)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Local Service Account JSON File Path (Alternative for local staging)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# =========================================================================
# CRYPTOGRAPHIC & RBAC SECURITY SECRETS
# =========================================================================

# Cryptographic Token Secrets (Must be at least 32 characters in production)
JWT_SECRET=production_super_secure_access_token_jwt_secret_change_me_2026
JWT_REFRESH_SECRET=production_super_secure_refresh_token_jwt_secret_change_me_2026

# Elevated Role Registration Gatekeeper Secrets
TEACHER_REGISTRATION_SECRET=TEACHER_SECRET_INVITE_2026
ADMIN_REGISTRATION_SECRET=ADMIN_SECRET_INVITE_2026

# Token Lifespans (Seconds)
JWT_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=604800
