# =========================================================================
# MINDPULSE BATTLE - CLIENT FIREBASE WEB CONFIGURATION
# Note: These values are public Firebase Web app configuration parameters.
# NEVER put service account JSON, private keys, or backend secrets here!
# =========================================================================

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# =========================================================================
# BACKEND ENDPOINT CONFIGURATION (Optional - defaults to localhost:4000)
# When deploying to Vercel as a separate project, set VITE_API_URL to your
# deployed server URL, e.g. https://mindpulse-server.vercel.app/api/v1
# =========================================================================
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
