# =========================================================================
# MINDPULSE BATTLE - CLIENT FIREBASE WEB CONFIGURATION
# Note: These values are public Firebase Web app configuration parameters.
# NEVER put service account JSON, private keys, or backend secrets here!
# =========================================================================

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# =========================================================================
# BACKEND ENDPOINT CONFIGURATION
# In local development, defaults to localhost:4000
# In production, set to your deployed backend server URL:
# - VITE_API_URL: e.g. https://your-backend.up.railway.app/api/v1
# - VITE_WS_URL:  e.g. https://your-backend.up.railway.app (or wss://...)
# IMPORTANT: Vercel Serverless Functions do NOT support persistent Socket.IO WebSockets.
# The backend must be hosted on a persistent Node.js environment (Railway, Render, Fly.io, Cloud Run).
# =========================================================================
VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
