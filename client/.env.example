# =========================================================================
# MINDPULSE BATTLE - CLIENT FIREBASE WEB CONFIGURATION
# Note: These values are public Firebase Web app configuration parameters.
# NEVER put service account JSON, private keys, or backend secrets here!
# =========================================================================

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# =========================================================================
# BACKEND ENDPOINT CONFIGURATION
# Single Vercel deployment: the client is served from the same origin and the
# production build falls back to `${window.location.origin}/api/v1`.
# In production, LEAVE VITE_API_URL and VITE_WS_URL UNSET so the same-origin
# /api/v1 path is used and the old Socket.IO URL is never used.
# - VITE_API_URL: only for LOCAL dev, default http://localhost:4000/api/v1
# - VITE_WS_URL:  legacy Socket.IO endpoint; no longer used by the game flow.
# =========================================================================
VITE_API_URL=http://localhost:4000/api/v1
# VITE_WS_URL=
